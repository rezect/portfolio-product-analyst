   "source": [
    "Преобразуем колонку с датой к нужному формату YYYY-MM-DD HH:MM"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "486ee092",
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "\n",
    "df = pd.read_csv(\"data.csv\", encoding='latin1')\n",
    "df[\"InvoiceDate\"] = pd.to_datetime(df[\"InvoiceDate\"], format=\"%m/%d/%Y %H:%M\")\n",
    "df.to_csv(\"data_formated.csv\")"
   ]
  }
